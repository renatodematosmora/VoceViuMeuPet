.swiftpm/
migrate_working_dir/

# Environment variables (SEGURANÇA: não commitar credenciais)
.env
.env.local
.env.*.local

# Configuração local do Claude Code (caminhos e workflow da máquina — não versionar)
.claude/
.claude/settings.local.json

# Artefatos/cache locais do Supabase CLI (regenerados localmente — não versionar)
supabase/.temp/
supabase/.branches/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
